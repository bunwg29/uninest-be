{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@common": ["./src/common"],
      "@common/*": ["./src/common/*"],
      "@common/constants": ["./src/common/constants"],
      "@common/constants/*": ["./src/common/constants/*"],
      "@constants": ["./src/common/constants"],
      "@constants/*": ["./src/common/constants/*"],
      "@common/decorators": ["./src/common/decorators"],
      "@common/decorators/*": ["./src/common/decorators/*"],
      "@decorators": ["./src/common/decorators"],
      "@decorators/*": ["./src/common/decorators/*"],
      "@common/dtos": ["./src/common/dtos"],
      "@common/dtos/*": ["./src/common/dtos/*"],
      "@dtos": ["./src/common/dtos"],
      "@dtos/*": ["./src/common/dtos/*"],
      "@common/filters": ["./src/common/filters"],
      "@common/filters/*": ["./src/common/filters/*"],
      "@filters": ["./src/common/filters"],
      "@filters/*": ["./src/common/filters/*"],
      "@common/interceptors": ["./src/common/interceptors"],
      "@common/interceptors/*": ["./src/common/interceptors/*"],
      "@interceptors": ["./src/common/interceptors"],
      "@interceptors/*": ["./src/common/interceptors/*"],
      "@common/pipes": ["./src/common/pipes"],
      "@common/pipes/*": ["./src/common/pipes/*"],
      "@pipes": ["./src/common/pipes"],
      "@pipes/*": ["./src/common/pipes/*"],
      "@core": ["./src/core"],
      "@core/*": ["./src/core/*"],
      "@core/config": ["./src/core/config"],
      "@core/config/*": ["./src/core/config/*"],
      "@config": ["./src/core/config"],
      "@config/*": ["./src/core/config/*"],
      "@core/database": ["./src/core/database"],
      "@core/database/*": ["./src/core/database/*"],
      "@database": ["./src/core/database"],
      "@database/*": ["./src/core/database/*"],
      "@core/storage": ["./src/core/storage"],
      "@core/storage/*": ["./src/core/storage/*"],
      "@storage": ["./src/core/storage"],
      "@storage/*": ["./src/core/storage/*"],
      "@modules": ["./src/modules"],
      "@modules/*": ["./src/modules/*"]
    },
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": ["dist", "node_modules", "test", "coverage", "vitest.config.mts"]
}
