# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# PostgreSQL 18 Local Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_DATABASE=uninest
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_POOL_SIZE=20

# Cloudflare R2 Object Storage Configuration (S3 Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=uninest-assets
R2_PUBLIC_URL=https://pub-250e35ee14664cab87368a3ea466d91f.r2.dev
PIXABAY_API_KEY=

# JWT Configuration
JWT_ACCESS_SECRET=uninest_dev_access_secret_key_32bytes!
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=uninest_dev_refresh_secret_key_32bytes!
JWT_REFRESH_EXPIRES_IN=30d

# Booking Configuration
BOOKING_RESPONSE_HOURS=24
HOLDING_DAYS=7
CANCEL_FREE_HOURS=24

# Notification Configuration (Redis + BullMQ, Expo Push)
REDIS_URL=redis://localhost:6379
EXPO_PUSH_ACCESS_TOKEN=

# Forum Moderation Configuration
FORUM_REPORT_HIDE_THRESHOLD=5
